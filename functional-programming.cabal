cabal-version: 2.4
name: functional-programming
version: 0.1.0.0
synopsis: Small functional programming examples
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Functional
  build-depends: base >=4.18 && <5
  default-language: Haskell2010
  ghc-options: -Wall

executable functional-examples
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base >=4.18 && <5, functional-programming
  default-language: Haskell2010
  ghc-options: -Wall

test-suite functional-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: base >=4.18 && <5, functional-programming
  default-language: Haskell2010
  ghc-options: -Wall
